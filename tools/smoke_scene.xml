<mujoco model="robogym smoke test scene">
  <!-- 测试场景：Franka Panda + 桌面 + 可抓取方块
       注意：这是自建测试素材，不是真实拍摄视频。 -->
  <include file="/media/data1/RoboLab_data/assets/mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.25 0.28 0.32 1"/>
    <global azimuth="135" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.62 0.72" rgb2="0.22 0.24 0.28" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="flat" rgb1="0.34 0.35 0.37" width="128" height="128"/>
    <texture type="2d" name="wood" builtin="checker" mark="edge"
             rgb1="0.62 0.47 0.32" rgb2="0.55 0.41 0.27"
             markrgb="0.48 0.36 0.24" width="256" height="256"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true"/>
    <material name="table_mat" texture="wood" texuniform="true" texrepeat="3 3" reflectance="0.06"/>
    <material name="cube_mat" rgba="0.16 0.42 0.78 1" reflectance="0.12"/>
  </asset>

  <worldbody>
    <light pos="0.3 0 2.2" dir="0 0 -1" directional="true"
           diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2" castshadow="true"/>
    <light pos="-1.2 1.0 1.8" diffuse="0.35 0.35 0.38"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor_mat"/>

    <!-- 桌面 -->
    <body name="table" pos="0.62 0 0.30">
      <geom name="table_top" type="box" size="0.32 0.42 0.02" material="table_mat"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.15" pos="-0.28 0.38 -0.17" rgba="0.3 0.3 0.32 1"/>
      <geom name="table_leg_fr" type="box" size="0.02 0.02 0.15" pos="-0.28 -0.38 -0.17" rgba="0.3 0.3 0.32 1"/>
      <geom name="table_leg_bl" type="box" size="0.02 0.02 0.15" pos="0.28 0.38 -0.17" rgba="0.3 0.3 0.32 1"/>
      <geom name="table_leg_br" type="box" size="0.02 0.02 0.15" pos="0.28 -0.38 -0.17" rgba="0.3 0.3 0.32 1"/>
    </body>

    <!-- 交互物体：一个方块，桌面 y=0.34 -->
    <body name="target_cube" pos="0.62 0.0 0.37">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025"
            material="cube_mat" mass="0.08"
            friction="1.2 0.02 0.001"/>
    </body>

    <!-- 落点区域标记（视觉参考，无碰撞） -->
    <geom name="goal_marker" type="cylinder" size="0.032 0.001" pos="0.62 0.22 0.321"
          rgba="0.2 0.7 0.3 0.5" contype="0" conaffinity="0"/>

    <!-- 固定相机：贴近真实"桌面操作视角" -->
    <camera name="front_view" pos="0.02 -0.78 0.62"
            xyaxes="1 0 0 0 0.42 0.91" fovy="48"/>
  </worldbody>
</mujoco>
